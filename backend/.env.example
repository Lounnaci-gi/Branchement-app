# Base de données SQL Server
DB_USER=sa
DB_PASSWORD=VotreMotDePasse
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=BranchementAEP
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUSTED_CONNECTION=true

# Serveur API
PORT=5000

# JWT (authentification)
# OBLIGATOIRE : générer une clé aléatoire forte, ex : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_CLE_ALEATOIRE_FORTE_D_AU_MOINS_32_CARACTERES
JWT_EXPIRES_IN=8h

# CORS — origines frontend autorisées (séparées par virgules si plusieurs)
# En développement : http://localhost:5173
# En production : https://votre-domaine.com
CORS_ORIGIN=http://localhost:5173

# Upload de fichiers
UPLOAD_DIR=./uploads
